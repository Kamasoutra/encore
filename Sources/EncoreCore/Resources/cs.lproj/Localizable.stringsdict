	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld položky smazány · ⌘Z pro odvolání</string>
			<key>many</key>
			<string>%lld položky smazáno · ⌘Z pro odvolání</string>
			<key>one</key>
			<string>%lld položka smazána · ⌘Z pro odvolání</string>
			<key>other</key>
			<string>%lld položek smazáno · ⌘Z pro odvolání</string>
		</dict>
	</dict>
	<key>%lld items would expire immediately.</key>
