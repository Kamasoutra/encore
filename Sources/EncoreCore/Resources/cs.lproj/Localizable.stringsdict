	<key>Apply and delete %lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Použít a smazat %lld položky</string>
			<key>many</key>
			<string>Použít a smazat %lld položky</string>
			<key>one</key>
			<string>Použít a smazat %lld položku</string>
			<key>other</key>
			<string>Použít a smazat %lld položek</string>
		</dict>
	</dict>
</dict>
</plist>
