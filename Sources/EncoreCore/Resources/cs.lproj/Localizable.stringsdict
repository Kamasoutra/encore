		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Importovány %lld nové položky</string>
			<key>many</key>
			<string>Importováno %lld nové položky</string>
			<key>one</key>
			<string>Importována %lld nová položka</string>
			<key>other</key>
			<string>Importováno %lld nových položek</string>
		</dict>
	</dict>
	<key>%lld weeks (unit)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>týdny</string>
			<key>many</key>
			<string>týdne</string>
			<key>one</key>
			<string>týden</string>
			<key>other</key>
			<string>týdnů</string>
		</dict>
