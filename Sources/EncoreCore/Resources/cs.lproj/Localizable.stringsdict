			<key>one</key>
			<string>%lld položce by okamžitě vypršela doba.</string>
			<key>other</key>
			<string>%lld položkám by okamžitě vypršela doba.</string>
		</dict>
	</dict>
	<key>%lld minutes (unit)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>minuty</string>
			<key>many</key>
			<string>minuty</string>
			<key>one</key>
			<string>minuta</string>
