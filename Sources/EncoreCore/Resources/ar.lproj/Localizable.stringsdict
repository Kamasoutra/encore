		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld أحرف</string>
			<key>many</key>
			<string>%lld حرفًا</string>
			<key>one</key>
			<string>حرف واحد</string>
			<key>other</key>
			<string>%lld حرف</string>
			<key>two</key>
			<string>حرفان</string>
			<key>zero</key>
			<string>%lld حرف</string>
		</dict>
	</dict>
