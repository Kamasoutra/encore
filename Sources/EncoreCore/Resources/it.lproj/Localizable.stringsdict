			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>settimana</string>
			<key>many</key>
			<string>settimane</string>
			<key>other</key>
			<string>settimane</string>
		</dict>
	</dict>
	<key>Apply and delete %lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Applica ed elimina %lld elemento</string>
			<key>many</key>
			<string>Applica ed elimina %lld di elementi</string>
			<key>other</key>
			<string>Applica ed elimina %lld elementi</string>
		</dict>
	</dict>
</dict>
</plist>
