	<key>Apply and delete %lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Aplicar e apagar %lld item</string>
			<key>many</key>
			<string>Aplicar e apagar %lld de itens</string>
			<key>other</key>
			<string>Aplicar e apagar %lld itens</string>
		</dict>
	</dict>
</dict>
</plist>
