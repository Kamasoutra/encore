			<string>lld</string>
			<key>one</key>
			<string>kuukausi</string>
			<key>other</key>
			<string>kuukautta</string>
		</dict>
	</dict>
	<key>%lld new items imported</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld uusi kohde tuotu</string>
			<key>other</key>
			<string>%lld uutta kohdetta tuotu</string>
		</dict>
